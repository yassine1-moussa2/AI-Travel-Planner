# Copy this file to .env.local and fill in your keys:  cp .env.example .env.local
# .env.local is gitignored. Never commit it.

# Free, no credit card: https://www.geoapify.com  (about 3,000 requests a day)
GEOAPIFY_API_KEY=

# Free tier, no credit card: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Google retires model names over time; if planning fails with
# "model isn't available", set this (gemini-flash-latest always tracks the current Flash).
GEMINI_MODEL=gemini-3.6-flash

# Optional. Set to 1 to print every planning step and its timing in the terminal.
PLANNER_DEBUG=0
